{
    "expo": {
        "name": "Rea",
        "slug": "rea",
        "version": "0.2.0",
        "orientation": "portrait",
        "scheme": "rea",
        "icon": "./assets/branding/icon.png",
        "userInterfaceStyle": "light",
        "splash": {
            "image": "./assets/branding/splash-icon.png",
            "resizeMode": "contain",
            "backgroundColor": "#E8F8FE"
        },
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "app.rea.personal",
            "buildNumber": "5",
            "icon": "./assets/branding/icon.png"
        },
        "android": {
            "package": "app.rea.personal",
            "versionCode": 5,
            "adaptiveIcon": {
                "foregroundImage": "./assets/branding/adaptive-foreground.png",
                "monochromeImage": "./assets/branding/adaptive-monochrome.png",
                "backgroundColor": "#E8F8FE"
            }
        },
        "plugins": [
            "expo-sqlite",
            [
                "expo-notifications",
                {
                    "icon": "./assets/branding/notification-icon.png",
                    "color": "#087C9B",
                    "defaultChannel": "default"
                }
            ],
            "expo-status-bar"
        ]
    }
}
