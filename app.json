{
    "expo": {
        "name": "Rea",
        "slug": "rea",
        "version": "0.2.0",
        "orientation": "portrait",
        "scheme": "rea",
        "icon": "./assets/images/branding/icon.png",
        "userInterfaceStyle": "automatic",
        "splash": {
            "image": "./assets/images/branding/adaptive-monochrome.png",
            "resizeMode": "contain",
            "backgroundColor": "#7CD9F9"
        },
        "ios": {
            "supportsTablet": true
        },
        "androidStatusBar": {
            "barStyle": "dark-content",
            "backgroundColor": "#7CD9F9"
        },
        "android": {
            "adaptiveIcon": {
                "backgroundColor": "#7CD9F9",
                "foregroundImage": "./assets/images/branding/adaptive-foreground.png",
                "backgroundImage": "./assets/images/branding/adaptive-foreground.png",
                "monochromeImage": "./assets/images/branding/adaptive-monochrome.png"
            },
            "predictiveBackGestureEnabled": false
        },
        "plugins": [
            [
                "expo-router",
                {
                    "root": "src/app"
                }
            ],
            [
                "expo-splash-screen",
                {
                    "backgroundColor": "#7CD9F9",
                    "image": "./assets/images/branding/adaptive-monochrome.png",
                    "imageWidth": 180,
                    "resizeMode": "contain",
                    "android": {
                        "backgroundColor": "#7CD9F9",
                        "image": "./assets/images/branding/adaptive-monochrome.png",
                        "imageWidth": 180
                    },
                    "ios": {
                        "backgroundColor": "#7CD9F9",
                        "image": "./assets/images/branding/adaptive-monochrome.png",
                        "imageWidth": 180
                    }
                }
            ],
            "expo-sqlite",
            "expo-localization"
        ],
        "experiments": {
            "typedRoutes": true,
            "tsconfigPaths": true
        },
        "extra": {
            "eas": {
                "projectId": "26cb52dd-a4ef-4b60-92be-42d4ca976332"
            }
        },
        "owner": "joalvm"
    }
}
