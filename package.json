{
    "name": "rea",
    "version": "1.0.0",
    "main": "expo-router/entry",
    "private": true,
    "scripts": {
        "start": "expo start",
        "start:e2e": "expo start --dev-client --no-dev --minify",
        "android": "expo run:android",
        "android:e2e": "powershell -ExecutionPolicy Bypass -File scripts/build-maestro-release.ps1",
        "ios": "expo run:ios",
        "lint": "expo lint",
        "lint:fix": "expo lint --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc --noEmit",
        "design:audit": "node scripts/audit-design-system.mjs",
        "test": "jest --runInBand",
        "test:unit": "jest test/unit --runInBand",
        "test:integration": "jest test/integration --runInBand",
        "test:db": "jest test/db-migrations --runInBand",
        "e2e": "npm run e2e:onboarding && npm run e2e:diario && npm run e2e:checkin && npm run e2e:calendar",
        "e2e:onboarding": "maestro test --config maestro/config.yaml --test-output-dir .maestro/tests --include-tags onboarding maestro",
        "e2e:diario": "maestro test --config maestro/config.yaml --test-output-dir .maestro/tests maestro/flows/diario/01-diario-lista.yaml && maestro test --config maestro/config.yaml --test-output-dir .maestro/tests maestro/flows/diario/02-diario-detalle.yaml",
        "e2e:checkin": "maestro test --config maestro/config.yaml --test-output-dir .maestro/tests --include-tags checkin maestro",
        "e2e:calendar": "maestro test --config maestro/config.yaml --test-output-dir .maestro/tests --include-tags calendar maestro",
        "e2e:visual": "maestro test --config maestro/config.yaml --test-output-dir .maestro/tests --include-tags accessibility maestro",
        "e2e:flow": "maestro test --config maestro/config.yaml --test-output-dir .maestro/tests --debug-output .maestro/debug"
    },
    "dependencies": {
        "@expo-google-fonts/nunito-sans": "^0.4.2",
        "@expo-google-fonts/quicksand": "^0.4.1",
        "drizzle-orm": "^0.45.2",
        "expo": "~56.0.15",
        "expo-constants": "~56.0.16",
        "expo-crypto": "~56.0.4",
        "expo-font": "~56.0.5",
        "expo-localization": "~56.0.6",
        "expo-notifications": "~56.0.20",
        "expo-router": "~56.2.14",
        "expo-splash-screen": "~56.0.12",
        "expo-sqlite": "~56.0.5",
        "expo-status-bar": "~56.0.4",
        "expo-system-ui": "~56.0.5",
        "i18next": "^26.3.2",
        "lucide-react-native": "^1.17.0",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-i18next": "^17.0.8",
        "react-native": "0.85.3",
        "react-native-reanimated": "4.3.1",
        "react-native-safe-area-context": "~5.7.0",
        "react-native-screens": "4.25.2",
        "react-native-svg": "15.15.4",
        "react-native-svg-transformer": "^1.5.3",
        "react-native-worklets": "0.8.3",
        "zod": "^4.4.3",
        "zustand": "^5.0.14"
    },
    "devDependencies": {
        "@babel/core": "^7.29.0",
        "@libsql/client": "^0.17.3",
        "@types/jest": "29.5.14",
        "@types/react": "~19.2.3",
        "babel-plugin-inline-import": "^3.0.0",
        "babel-preset-expo": "~56.0.0",
        "drizzle-kit": "^0.31.10",
        "eslint": "^9.39.4",
        "eslint-config-expo": "~56.0.4",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-unused-imports": "^4.4.1",
        "globals": "^17.6.0",
        "jest": "~29.7.0",
        "jest-expo": "~56.0.5",
        "prettier": "^3.8.3",
        "typescript": "~6.0.3"
    }
}
