{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "rootDir": "./src",
        "paths": {
            "@/*": [
                "./src/*"
            ],
            "@assets/*": [
                "./assets/*"
            ]
        }
    },
    "include": [
        "assets/**/*",
        "src/**/*",
        ".expo/types/**/*.ts",
        "expo-env.d.ts"
    ],
    "exclude": [
        "__legacy__/**/*",
        "node_modules/**/*",
        "babel.config.js",
    ]
}